dist/
out/
*.dmg
*.blockmap
*.app/
*.exe
*.AppImage
*.deb
*.snap

# ---- logs, caches, temp files ----
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log
*.tmp
.cache/
coverage/

# ---- OS / editor junk ----
.DS_Store
._*
Thumbs.db
Desktop.ini
.idea/
.vscode/
*.swp
*~

# ---- local secrets (code signing / notarization) ----
.env
.env.*
*.p12
*.cer
*.provisionprofile
